{
  "name": "chess-option-drag",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Browser extension: Option + drag draws arrows on chess.com from a trackpad.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
